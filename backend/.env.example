# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/anticamera_db

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=anticamera_backend_service
MQTT_TELEMETRY_TOPIC=anticamera/+/telemetry

# Risk Analysis Configuration
RF_THRESHOLD=2000
SUSPICIOUS_SSID_KEYWORDS=spycam,camera,hidden,surveillance,monitor

# CORS / Socket.IO Allowed Origins
CLIENT_ORIGIN=*
