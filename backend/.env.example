# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/anticamera_db

# MQTT Configuration
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=anticamera_backend_service
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TELEMETRY=anticamera/+/telemetry
MQTT_TOPIC_STATUS=anticamera/+/status
MQTT_TOPIC_ALERTS=anticamera/+/alerts
MQTT_TOPIC_COMMANDS=anticamera/+/commands

# Risk Engine Threshold
RF_THRESHOLD=2000

# CORS Configuration
CORS_ORIGIN=*

